    btn.MouseButton1Click:Connect(function()
        if activeTab then
            activeTab.btn.BackgroundTransparency=1
            activeTab.btn.TextColor3=Th.Sub
            activeTab.panel.Visible=false
        end
        activeTab=t
        btn.BackgroundTransparency=0
        btn.BackgroundColor3=Th.Accent
