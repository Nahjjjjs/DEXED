        BorderSizePixel=0,
    }, outer); rnd(bubble,8)
    pad(bubble,8,10,8,10)
    list(bubble,_,6)

    if not isUser then
        local blocks = AI:ParseBlocks(text)
        for i, blk in ipairs(blocks) do
            if blk.kind == "text" then
                local t = blk.content:gsub("^%s+",""):gsub("%s+$","")
                if t ~= "" then
                    mk("TextLabel",{
                        Text=t, Font=Enum.Font.Gotham, TextSize=11,
                        TextColor3=Th.Text, BackgroundTransparency=1,
                        Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
                        TextWrapped=true, TextXAlignment=Enum.TextXAlignment.Left,
                        LayoutOrder=i,
                    }, bubble)
                end
            else
                codeWidget(blk.content:gsub("^%s+",""):gsub("%s+$",""), bubble, i)
            end
        end
    else
        mk("TextLabel",{
            Text=text, Font=Enum.Font.Gotham, TextSize=11,
            TextColor3=Color3.new(1,1,1), BackgroundTransparency=1,
            Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y,
