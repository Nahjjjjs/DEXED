        LayoutOrder=slogN,
    }, SLogScroll)
    task.defer(function()
        SLogScroll.CanvasPosition = Vector2.new(0, 1e6)
    end)
end

PushB.MouseButton1Click:Connect(function()
    local name = SNameIn.Text:gsub("%.lua$","")
    local code = SCodeIn.Text
    if name=="" or code=="" then slog("Empty name or code.", Th.Err); return end
    local ok, result = DeltaSync:Push(name, code)
    if ok then
        slog("Pushed → "..result, Th.Ok)
        SStatusLbl.Text="✓ Synced: "..result
        SStatusLbl.TextColor3=Th.Ok
    else
        slog("Push failed: "..result, Th.Err)
        SStatusLbl.Text="✕ "..result
        SStatusLbl.TextColor3=Th.Err
    end
end)

PullB.MouseButton1Click:Connect(function()
    local name = SNameIn.Text:gsub("%.lua$","")
    local content = DeltaSync:Pull(name)
    if content then
        SCodeIn.Text=content
        slog("Pulled ← DEXED_Sync/"..name..".lua", Th.Accent)
        SStatusLbl.Text="✓ Pulled"; SStatusLbl.TextColor3=Th.Accent
    else
        slog("Not found: DEXED_Sync/"..name..".lua", Th.Err)
        SStatusLbl.Text="✕ File not found"; SStatusLbl.TextColor3=Th.Err
    end
end)

RunSB.MouseButton1Click:Connect(function()
    local fn, err = loadstring(SCodeIn.Text)
    if fn then
        local ok, e = pcall(fn)
        slog(ok and "Executed OK." or "Runtime: "..tostring(e), ok and Th.Ok or Th.Err)
    else
        slog("Syntax: "..tostring(err), Th.Err)
    end
end)

CpySB.MouseButton1Click:Connect(function()
    copyToClipboard(SCodeIn.Text)
    CpySB.Text="✓ Copied"
    task.delay(1.5, function() CpySB.Text="Copy" end)
end)

