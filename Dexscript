    btn.MouseEnter:Connect(function()
        if activeTab~=t then btn.BackgroundTransparency=0.75; btn.BackgroundColor3=Th.Accent end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab~=t then btn.BackgroundTransparency=1 end
    end)
    return t
