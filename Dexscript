-- ══ Executor Abstractions ══════════════════════════════════════════
local function httpRequest(opts)
    if syn and syn.request       then return syn.request(opts)
    elseif request               then return request(opts)
    elseif http_request          then return http_request(opts)
    elseif fluxus and fluxus.request then return fluxus.request(opts)
    else error("No HTTP function available in this executor.") end
end

local function writeFile(path, data)
    if writefile then writefile(path, data) end
end

local function readFile(path)
    if readfile then
        local ok, v = pcall(readfile, path)
        return ok and v or nil
    end
end

local function makeDir(path)
    if makefolder and not (isfolder and isfolder(path)) then
        pcall(makefolder, path)
    end
end

local function copyToClipboard(text)
    if setclipboard      then setclipboard(text)
    elseif toclipboard   then toclipboard(text) end
end

-- ══ Delta Sync ════════════════════════════════════════════════════
local DeltaSync = { Folder = "DEXED_Sync", Log = {} }

function DeltaSync:Init()
    makeDir(self.Folder)
end

function DeltaSync:Push(name, code)
    local path = self.Folder .. "/" .. name:gsub("%.lua$","") .. ".lua"
    local ok, err = pcall(writeFile, path, code)
    if ok then
        table.insert(self.Log, 1, {op="push", path=path, t=os.time()})
        return true, path
    end
    return false, tostring(err)
end

function DeltaSync:Pull(name)
    return readFile(self.Folder .. "/" .. name:gsub("%.lua$","") .. ".lua")
end

-- ══ Remote Spy ════════════════════════════════════════════════════
local RemoteSpy = {
    Active    = false,
    Log       = {},
    MaxLog    = 500,
    Callbacks = {},
    _orig     = nil,
}

function RemoteSpy:Start()
    if self.Active then return end
    self.Active = true
    local mt   = getrawmetatable(game)
    local orig = mt.__namecall
    self._orig = orig
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(obj, ...)
        local method = getnamecallmethod()
        local args   = {...}
        if (method == "FireServer"   and obj:IsA("RemoteEvent")) or
           (method == "InvokeServer" and obj:IsA("RemoteFunction")) then
            local entry = {
                rtype  = obj.ClassName,
                name   = obj.Name,
                path   = obj:GetFullName(),
                args   = args,
                t      = os.clock(),
                obj    = obj,
            }
            table.insert(self.Log, 1, entry)
            if #self.Log > self.MaxLog then table.remove(self.Log) end
            for _, cb in ipairs(self.Callbacks) do pcall(cb, entry) end
        end
        return orig(obj, ...)
    end)
    setreadonly(mt, true)
end

function RemoteSpy:Stop()
    if not self.Active then return end
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    mt.__namecall = self._orig
    setreadonly(mt, true)
    self.Active = false
end

function RemoteSpy:Clear()
    self.Log = {}
end

function RemoteSpy:BuildScript(entry)
    local parts = {}
    for _, arg in ipairs(entry.args) do
        local t = type(arg)
        if     t == "string"  then table.insert(parts, string.format("%q", arg))
        elseif t == "number" or t == "boolean" then table.insert(parts, tostring(arg))
        elseif t == "table"   then
            local ok, json = pcall(HttpSvc.JSONEncode, HttpSvc, arg)
            table.insert(parts, ok and json or "-- [table]")
        elseif typeof(arg) == "Instance" then
            table.insert(parts, string.format('game:GetService("%s"):WaitForChild("%s")',
                arg.ClassName, arg.Name))
        else
            table.insert(parts, "-- [" .. typeof(arg) .. "]")
        end
    end
    local argStr = table.concat(parts, ", ")
    local svc    = entry.path:match("^([^.]+)")
    local remote = string.format(
        'game:GetService("%s"):WaitForChild("%s")',
        svc or "ReplicatedStorage", entry.name
    )
    if entry.rtype == "RemoteEvent" then
        return string.format("%s:FireServer(%s)", remote, argStr)
    else
        return string.format('local result = %s:InvokeServer(%s)\nprint(result)', remote, argStr)
    end
end

-- ══ AI Chat ═══════════════════════════════════════════════════════
local AI = {
    Provider = "pollinations",  -- "pollinations" | "openrouter" | "groq"
    APIKey   = "",
    Model    = "openai",        -- pollinations default
    History  = {},
    System   = [[You are a Roblox Luau scripting expert for executor context.
When writing code, always use ```lua code blocks.
Scripts must be executor-compatible. Use game services correctly.
Never use wait() — use task.wait(). Keep scripts concise and functional.]],
}

function AI:Send(userMsg, callback)
    table.insert(self.History, {role="user", content=userMsg})
    local msgs = {{role="system", content=self.System}}
    for _, m in ipairs(self.History) do table.insert(msgs, m) end

    local url, headers, body

    if self.Provider == "pollinations" then
        url     = "https://text.pollinations.ai/openai"
        headers = {["Content-Type"]="application/json"}
        body    = HttpSvc:JSONEncode({
            model    = "openai",
            messages = msgs,
            seed     = math.random(1, 99999),
        })
    elseif self.Provider == "openrouter" then
        url     = "https://openrouter.ai/api/v1/chat/completions"
        headers = {
            ["Content-Type"]  = "application/json",
            ["Authorization"] = "Bearer " .. self.APIKey,
            ["HTTP-Referer"]  = "https://roblox.com",
            ["X-Title"]       = "DEXED",
        }
        body = HttpSvc:JSONEncode({
            model    = (self.Model ~= "" and self.Model or "deepseek/deepseek-r1:free"),
            messages = msgs,
        })
    elseif self.Provider == "groq" then
        url     = "https://api.groq.com/openai/v1/chat/completions"
        headers = {
            ["Content-Type"]  = "application/json",
            ["Authorization"] = "Bearer " .. self.APIKey,
        }
        body = HttpSvc:JSONEncode({
            model    = (self.Model ~= "" and self.Model or "llama-3.3-70b-versatile"),
            messages = msgs,
        })
    end

    task.spawn(function()
        local ok, resp = pcall(httpRequest, {
            Url = url, Method = "POST", Headers = headers, Body = body,
        })
        if not ok then
            callback(nil, "HTTP: " .. tostring(resp)); return
        end
        local dok, parsed = pcall(HttpSvc.JSONDecode, HttpSvc, resp.Body)
        if not dok then
            callback(nil, "JSON: " .. tostring(parsed)); return
        end
        if parsed.error then
            callback(nil, "API: " .. (parsed.error.message or "unknown")); return
        end
        local reply = parsed.choices
            and parsed.choices[1]
            and parsed.choices[1].message
            and parsed.choices[1].message.content
        if not reply then callback(nil, "Empty response"); return end
        table.insert(self.History, {role="assistant", content=reply})
        callback(reply, nil)
    end)
end

function AI:ParseBlocks(text)
    -- returns list of {kind="text"|"code", content="..."}
    local blocks = {}
    local pos = 1
    while pos <= #text do
        local cs, lang_end = text:find("```[^\n]*\n", pos)
        if not cs then
            local chunk = text:sub(pos)
            if chunk:match("%S") then table.insert(blocks,{kind="text",content=chunk}) end
            break
        end
        if cs > pos then
            local before = text:sub(pos, cs-1)
            if before:match("%S") then table.insert(blocks,{kind="text",content=before}) end
        end
        local ce = text:find("```", lang_end+1)
        if ce then
            table.insert(blocks,{kind="code",content=text:sub(lang_end+1, ce-1)})
            pos = ce + 3
        else
            table.insert(blocks,{kind="code",content=text:sub(lang_end+1)})
            break
        end
    end
    return blocks
end

