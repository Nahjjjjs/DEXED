local function buildTree(inst, parent, depth)
    depth = depth or 0
    local ch = pcall(function()
        return inst:GetChildren()
    end) and inst:GetChildren() or {}

    local hasKids = #ch > 0
    local node = mk("Frame",{
        Size=UDim2.new(1,0,0,0), BackgroundTransparency=1,
        AutomaticSize=Enum.AutomaticSize.Y,
    }, parent)
    list(node,_,0)

    local indent = depth * 14
    local rowF = mk("Frame",{
        Size=UDim2.new(1,0,0,22), BackgroundColor3=Color3.new(0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0,
    }, node)

    local arrowBtn = mk("TextButton",{
        Text=hasKids and (expanded[inst] and "▼" or "▶") or " ",
        Font=Enum.Font.Gotham, TextSize=9, TextColor3=Th.Sub,
        BackgroundTransparency=1, Size=UDim2.new(0,14,1,0),
        Position=UDim2.new(0,indent,0,0), AutoButtonColor=false,
    }, rowF)

    mk("TextLabel",{
        Text=(ICONS[inst.ClassName] or "·").." "..inst.Name,
        Font=Enum.Font.Gotham, TextSize=11, TextColor3=Th.Text,
        BackgroundTransparency=1,
        Size=UDim2.new(1,-(indent+18),1,0), Position=UDim2.new(0,indent+16,0,0),
        TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,
    }, rowF)

    local rowClick = mk("TextButton",{
        Text="",BackgroundTransparency=1,
        Size=UDim2.new(1,0,1,0), AutoButtonColor=false,
    }, rowF)

    local kids = mk("Frame",{
        Size=UDim2.new(1,0,0,0), BackgroundTransparency=1,
        AutomaticSize=Enum.AutomaticSize.Y,
        Visible=expanded[inst] or false,
    }, node)
    list(kids,_,0)

    rowClick.MouseButton1Click:Connect(function()
        renderProps(inst)
    end)
    rowClick.MouseEnter:Connect(function() rowF.BackgroundTransparency=0.85; rowF.BackgroundColor3=Th.Accent end)
    rowClick.MouseLeave:Connect(function() rowF.BackgroundTransparency=1 end)

    if hasKids then
        local function toggle()
            expanded[inst] = not expanded[inst]
            kids.Visible = expanded[inst]
            arrowBtn.Text = expanded[inst] and "▼" or "▶"
            if expanded[inst] then
                for _, c in ipairs(kids:GetChildren()) do
                    if not c:IsA("UIListLayout") then c:Destroy() end
                end
                for _, child in ipairs(ch) do
                    buildTree(child, kids, depth+1)
                end
            end
        end
        arrowBtn.MouseButton1Click:Connect(toggle)
    end
end

